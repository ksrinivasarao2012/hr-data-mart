# Copy to .env and fill in. .env is gitignored — never commit it.

# --- Postgres (installed natively on Windows) -------------------------------
APP_DB_HOST=localhost
APP_DB_PORT=5432
APP_DB_USER=postgres
APP_DB_PASSWORD=CHANGE_ME_to_the_password_you_set_during_install
APP_DB_NAME=hr_mart

# --- LLM ---------------------------------------------------------------------
